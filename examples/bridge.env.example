# Secrets must be stored outside the repository, never committed.
BRIDGE_API_KEY=change-this-to-a-long-random-secret
BRIDGE_MAX_INFLIGHT=4

# Mode: bridge (default) | native | hybrid
BRIDGE_TOOL_MODE=bridge
BRIDGE_ALLOW_WEB_FALLBACK=false

# Native official DeepSeek API (separate credential)
DEEPSEEK_API_KEY=
DEEPSEEK_NATIVE_MODEL=deepseek-v4-pro

# Web transport; only used in bridge mode or when hybrid explicitly allows fallback
DEEPSEEK_AUTH_TOKEN=
DEEPSEEK_REQUEST_TIMEOUT=60
DEEPSEEK_STREAM_TIMEOUT=180
